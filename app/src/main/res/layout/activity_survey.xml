<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Page indicator -->
        <TextView
            android:id="@+id/pageIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Page 1 of 3"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp"/>

        <!-- Survey container -->
        <LinearLayout
            android:id="@+id/surveyContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Button will be added last -->
            <Button
                android:id="@+id/buttonSurvey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Survey"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/emergency_exit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Quick Exit"
                app:backgroundTint="#81D4FA"
                app:tint="@null"
                app:maxImageSize="210dp"
                app:srcCompat="@drawable/ic_quick_exit" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>
