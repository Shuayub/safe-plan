<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Page Indicator -->
            <TextView
                android:id="@+id/pageIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Page 1 of 3"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="16dp"/>

            <!-- Survey Container -->
            <LinearLayout
                android:id="@+id/surveyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Survey Button -->
                <Button
                    android:id="@+id/buttonSurvey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Survey"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="32dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Floating Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:paddingBottom="16dp">


        <!-- FAB centered at bottom -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/emergency_exit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="22dp"
            android:contentDescription="Quick Exit"
            app:backgroundTint="#81D4FA"
            app:tint="@null"
            app:maxImageSize="210dp"
            app:srcCompat="@drawable/ic_quick_exit"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>