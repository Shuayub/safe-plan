<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.weatherapp.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SupportFragment"
            app:destination="@id/SupportFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_ReminderFragment"
            app:destination="@id/ReminderFragment" />
    </fragment>
    <fragment
        android:id="@+id/SupportFragment"
        android:name="com.example.weatherapp.SupportFragment"
        tools:layout="@layout/fragment_support">
    </fragment>
    <fragment
        android:id="@+id/ReminderFragment"
        android:name="com.example.weatherapp.ReminderActivity"
        tools:layout="@layout/fragment_reminder">
    </fragment>
</navigation>